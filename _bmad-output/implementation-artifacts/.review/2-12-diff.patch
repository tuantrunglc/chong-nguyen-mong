+func _ghosts_of(before: BattleState, after: BattleState) -> Array[Dictionary]:
+	var ghosts: Array[Dictionary] = []
+	for unit: Unit in after.units:
+		var old: Unit = before.unit_by_id(unit.id)
+		if old == null:
